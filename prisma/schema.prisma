generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id            String          @id @default(cuid())
  orderCode     String   @unique
  amount        Int
  discount      Int             @default(0)
  couponCode    String?
  paymentMethod PaymentMethod
  paymentReference String?
  status        OrderStatus
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  notes         String?

  subtotal      Int
  taxableValue  Int
  cgst          Int
  sgst          Int
  igst          Int
  placeOfSupply String
  buyerGstin    String?
  buyerName     String?

  invoiceNumber String?   @unique
  invoiceDate   DateTime?
  sellerGstin   String?
  sellerLegalName String?
  sellerTradeName String?
  sellerAddress   String?
  sellerStateCode String?
  sellerEmail     String?
  sellerPhone     String?

  razorpayPaymentId  String?
  razorpayOrderId    String?

  user          User?           @relation(fields: [userId], references: [id])
  userId        String?

  address       Address?
  billingAddress BillingAddress?
  items         OrderItem[]
  history       StatusHistory[]
  creditNotes   CreditNote[]
  returnRequests ReturnRequest[]
  challans      JobWorkChallan[]

  @@index([userId])
}

model Tailor {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  addressLine1 String
  addressLine2 String?
  city         String
  stateCode    String
  pincode      String
  gstin        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  challans     JobWorkChallan[]
}

model JobWorkChallan {
  id               String    @id @default(cuid())
  number           String    @unique
  date             DateTime
  pieces           Json
  taxableValue     Int
  taxAmount        Int
  fabricBill       String?
  ewayBill         String?
  note             String?

  tailorName       String
  tailorAddress    String
  tailorStateCode  String
  tailorGstin      String?
  tailorPhone      String?

  sellerGstin      String
  sellerLegalName  String
  sellerTradeName  String
  sellerAddress    String
  sellerStateCode  String
  sellerEmail      String
  sellerPhone      String

  receivedAt       DateTime?
  receivedNote     String?
  receivedEwayBill String?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime  @default(now())

  order            Order     @relation(fields: [orderId], references: [id])
  orderId          String
  tailor           Tailor    @relation(fields: [tailorId], references: [id])
  tailorId         String
  lines            JobWorkChallanLine[]

  @@index([orderId])
  @@index([tailorId])
  @@index([date])
  @@index([receivedAt])
}

model JobWorkChallanLine {
  id           String         @id @default(cuid())
  position     Int
  kind         String
  description  String
  hsn          String
  quantity     Float
  unit         String
  taxableValue Int
  gstRate      Int
  taxAmount    Int

  challan      JobWorkChallan @relation(fields: [challanId], references: [id])
  challanId    String

  @@index([challanId])
}

model ReturnRequest {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  reason     String
  resolution String
  note       String?
  items      Json

  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String

  @@index([orderId])
}

model CreditNote {
  id              String   @id @default(cuid())
  number          String   @unique
  date            DateTime
  reason          String
  amount          Int
  taxableValue    Int
  cgst            Int
  sgst            Int
  igst            Int
  placeOfSupply   String
  buyerGstin      String?
  buyerName       String?
  invoiceNumber   String
  invoiceDate     DateTime
  invoiceAmount   Int
  sellerGstin     String
  sellerLegalName String
  sellerTradeName String
  sellerAddress   String
  sellerStateCode String
  sellerEmail     String
  sellerPhone     String
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id])
  orderId         String
  items           CreditNoteItem[]

  @@index([orderId])
  @@index([date])
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  orderItemId  String
  name         String
  size         String
  color        String?
  hsn          String
  gstRate      Int
  quantity     Int
  taxableValue Int
  taxAmount    Int

  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id])
  creditNoteId String

  @@index([creditNoteId])
}

model User {
  id          String        @id @default(cuid())
  email       String        @unique
  name        String?
  phone       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  lastLoginAt DateTime?

  orders      Order[]
  addresses   UserAddress[]
  sessions    UserSession[]
  wishlist    WishlistItem[]
  bag         BagItem[]
  measurements MeasurementProfile[]
}

model MeasurementProfile {
  id              String   @id @default(cuid())
  name            String
  kind            String
  values          Json
  notes           String?
  guardianConsent Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String

  @@index([userId])
}

model WishlistItem {
  id             String   @id @default(cuid())
  slug           String
  name           String
  price          Int
  coverThumbnail String
  coverImage     String?
  sizes          String[]
  addedAt        DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  @@unique([userId, slug])
  @@index([userId])
}

model BagItem {
  id             String   @id @default(cuid())
  slug           String
  size           String
  color          String?
  name           String
  price          Int
  coverThumbnail String
  quantity       Int      @default(1)
  profileId      String?
  profileName    String?
  updatedAt      DateTime @default(now()) @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  @@unique([userId, slug, size, color, profileId])
  @@index([userId])
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
}

model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model UserAddress {
  id           String   @id @default(cuid())
  label        String?
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String

  @@index([userId])
}

model Address {
  id           String   @id @default(cuid())
  fullName     String
  phone        String
  email        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  stateCode    String
  pincode      String

  order        Order    @relation(fields: [orderId], references: [id])
  orderId      String   @unique
}

model BillingAddress {
  id           String   @id @default(cuid())
  fullName     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  stateCode    String
  pincode      String

  order        Order    @relation(fields: [orderId], references: [id])
  orderId      String   @unique
}

model OrderItem {
  id             String  @id @default(cuid())
  name           String
  slug           String
  size           String
  color          String?
  price          Int
  quantity       Int     @default(1)
  coverThumbnail String

  hsn            String
  gstRate        Int
  discount       Int
  taxableValue   Int
  taxAmount      Int

  pattern                 Json?
  measurements            Json?
  measurementsConfirmedAt DateTime?
  measurementsConfirmNote String?

  order          Order   @relation(fields: [orderId], references: [id])
  orderId        String
}

model StatusHistory {
  id        String      @id @default(cuid())
  status    OrderStatus
  changedAt DateTime    @default(now())
  note      String?

  order     Order       @relation(fields: [orderId], references: [id])
  orderId   String
}

enum PaymentMethod {
  UPI_MANUAL
  COD
  RAZORPAY
}

enum OrderStatus {
  UNDER_VERIFICATION
  VERIFIED
  REJECTED

  PROCESSING
  SHIPPED
  DELIVERED

  CANCELLED
  REFUNDED

  RETURN_REQUESTED
  RETURN_RECEIVED
  EXCHANGE_DISPATCHED
  EXCHANGE_COMPLETED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  discountType   DiscountType
  discountValue  Int
  minOrderAmount Int?
  maxUses        Int?
  currentUses    Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
}

model GstFiling {
  id        String    @id @default(cuid())
  kind      String
  period    String
  itcIgst   Int       @default(0)
  itcCgst   Int       @default(0)
  itcSgst   Int       @default(0)
  paidIgst  Int       @default(0)
  paidCgst  Int       @default(0)
  paidSgst  Int       @default(0)
  filedAt   DateTime?
  reference String?
  note      String?
  snapshot  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@unique([kind, period])
}

model InvoiceCounter {
  financialYear String @id
  last          Int
}

model HiddenProduct {
  slug     String   @id
  hiddenAt DateTime @default(now())
}

model SoldOutProduct {
  slug      String   @id
  soldOutAt DateTime @default(now())
}

model RestockRequest {
  id        String   @id @default(cuid())
  slug      String
  email     String
  createdAt DateTime @default(now())

  @@unique([slug, email])
  @@index([slug])
}

model AdminSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model AdminLoginChallenge {
  key         String   @id
  challengeId String   @unique
  codeHash       String
  magicTokenHash String
  expiresAt      DateTime
  attempts    Int      @default(0)
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
}
