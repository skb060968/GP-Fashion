generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id            String          @id @default(cuid())
  orderCode     String   @unique    
  amount        Int
  discount      Int             @default(0)        // ✅ new field for order-level discount
  couponCode    String?                             // applied coupon code (null if no coupon)
  paymentMethod PaymentMethod
  status        OrderStatus
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  notes         String?                             // internal admin notes, never shown to customers

  razorpayPaymentId  String?
  razorpayOrderId    String?

  // Set when a signed-in customer places the order. Guest orders stay null and
  // are matched to an account by email at read time.
  user          User?           @relation(fields: [userId], references: [id])
  userId        String?

  address       Address?
  items         OrderItem[]
  history       StatusHistory[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Customer accounts (passwordless: email + one-time code)
// ---------------------------------------------------------------------------

model User {
  id          String        @id @default(cuid())
  email       String        @unique                  // stored lower-cased
  name        String?
  phone       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  lastLoginAt DateTime?

  orders      Order[]
  addresses   UserAddress[]
  sessions    UserSession[]
  wishlist    WishlistItem[]
  bag         BagItem[]
}

/** A saved product. Snapshot fields so the list renders without a catalogue lookup. */
model WishlistItem {
  id             String   @id @default(cuid())
  slug           String
  name           String
  price          Int
  coverThumbnail String
  coverImage     String?
  sizes          String[]
  addedAt        DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  @@unique([userId, slug])
  @@index([userId])
}

/** A line in the customer's shopping bag. */
model BagItem {
  id             String   @id @default(cuid())
  slug           String
  size           String
  name           String
  price          Int
  coverThumbnail String
  quantity       Int      @default(1)
  updatedAt      DateTime @default(now()) @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  @@unique([userId, slug, size])
  @@index([userId])
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique                           // sha256 of the cookie token
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
}

model LoginCode {
  id         String    @id @default(cuid())
  email      String                                    // lower-cased
  codeHash   String                                    // sha256(email:code)
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model UserAddress {
  id           String   @id @default(cuid())
  label        String?                                 // "Home", "Office"
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String

  @@index([userId])
}

model Address {
  id           String   @id @default(cuid())
  fullName     String
  phone        String
  email        String?                         // ✅ new field for customer email
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String

  order        Order    @relation(fields: [orderId], references: [id])
  orderId      String   @unique
}

model OrderItem {
  id             String @id @default(cuid())
  name           String
  slug           String
  size           String
  price          Int
  quantity       Int    @default(1)            // ✅ new field for number of items
  coverThumbnail String

  order          Order  @relation(fields: [orderId], references: [id])
  orderId        String
}

model StatusHistory {
  id        String      @id @default(cuid())
  status    OrderStatus
  changedAt DateTime    @default(now())
  note      String?                           // optional reason recorded with the change

  order     Order       @relation(fields: [orderId], references: [id])
  orderId   String
}

enum PaymentMethod {
  UPI_MANUAL
  COD
  RAZORPAY
}

enum OrderStatus {
  UNDER_VERIFICATION   // Order placed, payment claimed by customer
  VERIFIED             // Payment verified by admin
  REJECTED             // Payment rejected (fake / mismatch)

  PROCESSING           // Order accepted, being prepared
  SHIPPED              // Given to courier
  DELIVERED            // Successfully delivered

  CANCELLED            // Cancelled before shipment
  REFUNDED             // Money returned to customer
}


enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  discountType   DiscountType
  discountValue  Int                // percentage (e.g. 10 for 10%) or fixed amount in paise
  minOrderAmount Int?               // optional minimum order subtotal in paise
  maxUses        Int?               // optional usage cap
  currentUses    Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
}

model AdminSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique        // sha256 of the random token
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}
